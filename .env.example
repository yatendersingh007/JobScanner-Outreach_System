# Workflow D — copy to .env, never commit (HARD RULE 6)
TEST_MODE=true

# New bot, NOT Workflow C's @Manpconnections_bot
TELEGRAM_BOT_TOKEN_D=
TELEGRAM_CHAT_ID=
AUTHORIZED_USER_IDS=

# Budget guards (HARD RULE 10)
GATE_CAP_PER_RUN=10
REGATE_WINDOW_DAYS=90
DRAFT_CAP_PER_RUN=10
TINYFISH_STEP_CAP_PER_RUN=200
MAX_LLM_TOKENS_PER_FIRM=25000
EMAIL_MAX_WORDS=260

# Scheduled run scans and gates, then stops for a human. Leave false.
AUTO_DRAFT_ON_SCHEDULE=false
SECOND_RECIPIENT_ENABLED=false

SCANNER_CONFIG_PATH=/opt/workflow-d/scanner/config.yaml
EXPECTED_SOURCES=jsearch,SelectLeaders,eFinancialCareers,LinkedIn US,LinkedIn Canada

# Shared with Workflows A and C
DATABASE_URL=

# Metered services
RAPIDAPI_KEY=
TINYFISH_API_KEY=
TAVILY_API_KEYS=
APOLLO_API_KEY=
OPENAI_API_KEY=

GMAIL_CREDENTIALS_PATH=/opt/workflow-d/credentials.json
GMAIL_TOKEN_PATH=/opt/workflow-d/token.json

# --- Added for lib_referral/ + lib_snapshot/ + scanner/ vendoring (see DRIFT.md) ---
# lib_snapshot/config.py reads these directly; lib_snapshot/models.py (the LLM
# client used transitively by lib_referral/icp_gate.py and deck_filler.py)
# consumes them. NOTE: OPENAI_API_KEY above is NOT the same name as this one —
# the vendored code reads LLM_API_KEY, not OPENAI_API_KEY. Fill this one too.
LLM_API_KEY=
LLM_BASE_URL=
DEFAULT_MODEL=
PREMIUM_MODEL=

# lib_snapshot/config.py; lib_snapshot/db.py uses it for the connection pool's
# max_size (RESEARCH_WORKERS + 3).
RESEARCH_WORKERS=

# scanner/config.py's Config.jsearch_key property; scanner/connectors/adapters/jsearch.py.
# NOTE: RAPIDAPI_KEY above is NOT the same name as this one — JSearch is a
# RapidAPI product, but the vendored scanner/config.py reads JSEARCH_API_KEY,
# not RAPIDAPI_KEY. Fill this one too if the aggregator provider is jsearch.
JSEARCH_API_KEY=

# scanner/connectors/adapters/predictleads.py — read via a bare os.getenv,
# bypassing scanner/config.py's Config dataclass entirely. Only relevant if
# config.yaml's aggregator.provider is ever switched to "predictleads".
PREDICTLEADS_API_TOKEN=

# scanner/config.py's Config.theirstack_key property; scanner/connectors/adapters/theirstack.py.
# Only relevant if config.yaml's aggregator.provider is ever switched to "theirstack".
THEIRSTACK_API_KEY=
