# Workflow D — copy to .env, never commit (HARD RULE 6)
TEST_MODE=true

# New bot, NOT Workflow C's @Manpconnections_bot
TELEGRAM_BOT_TOKEN_D=
TELEGRAM_CHAT_ID=
AUTHORIZED_USER_IDS=

# Budget guards (HARD RULE 10)
GATE_CAP_PER_RUN=10
REGATE_WINDOW_DAYS=90
DRAFT_CAP_PER_RUN=10
TINYFISH_STEP_CAP_PER_RUN=200
MAX_LLM_TOKENS_PER_FIRM=25000
EMAIL_MAX_WORDS=260

# Scheduled run scans and gates, then stops for a human. Leave false.
AUTO_DRAFT_ON_SCHEDULE=false
SECOND_RECIPIENT_ENABLED=false

SCANNER_CONFIG_PATH=/opt/workflow-d/scanner/config.yaml
EXPECTED_SOURCES=jsearch,SelectLeaders,eFinancialCareers,LinkedIn US,LinkedIn Canada

# Shared with Workflows A and C
DATABASE_URL=

# Metered services
RAPIDAPI_KEY=
TINYFISH_API_KEY=
TAVILY_API_KEYS=
APOLLO_API_KEY=
OPENAI_API_KEY=

GMAIL_CREDENTIALS_PATH=/opt/workflow-d/credentials.json
GMAIL_TOKEN_PATH=/opt/workflow-d/token.json
