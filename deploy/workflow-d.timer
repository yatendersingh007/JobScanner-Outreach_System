[Unit]
Description=Workflow D daily scan at 09:00 America/New_York

[Timer]
# 9 AM Eastern year-round. Naming the zone rather than a fixed UTC hour is
# what makes DST correct: EST in winter, EDT in summer, always 09:00 local.
OnCalendar=*-*-* 09:00:00
Timezone=America/New_York
# A reboot or shutdown across 09:00 must not silently skip a day.
Persistent=true
# Move off the exact second, away from Workflow A and C timers.
RandomizedDelaySec=120
AccuracySec=1min
Unit=workflow-d.service

[Install]
WantedBy=timers.target
